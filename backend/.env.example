# Database connection settings.
# Local development default URL (non-production):
# GEOSHIELD_DB_URL=jdbc:mysql://localhost:3306/geoshield?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
#
# Production deployments MUST enforce TLS/SSL transport and server identity verification:
# GEOSHIELD_DB_URL=jdbc:mysql://db.prod.internal:3306/geoshield?sslMode=VERIFY_IDENTITY&serverTimezone=UTC
GEOSHIELD_DB_URL=jdbc:mysql://localhost:3306/geoshield?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
GEOSHIELD_DB_USERNAME=geoshield
GEOSHIELD_DB_PASSWORD=

# Development account seeding (strictly opt-in; false by default)
# When enabled in non-production profiles, seeds default admin and responder accounts.
GEOSHIELD_DEV_SEED_ENABLED=false

# JPA logging controls
GEOSHIELD_JPA_SHOW_SQL=false
GEOSHIELD_JPA_FORMAT_SQL=false

# Cryptographically secure random secret (minimum 32 UTF-8 bytes / 256 bits).
# Placeholder values containing 'CHANGE_ME' are strictly rejected at startup.
# Generate with: openssl rand -base64 32
GEOSHIELD_JWT_SECRET=
GEOSHIELD_JWT_ACCESS_TOKEN_TTL=PT15M
GEOSHIELD_JWT_REFRESH_TOKEN_TTL=P30D
GEOSHIELD_BCRYPT_STRENGTH=12

# Risk weights (frozen baseline)
GEOSHIELD_RISK_HISTORICAL_INCIDENT_WEIGHT=0.30
GEOSHIELD_RISK_WEATHER_WEIGHT=0.20
GEOSHIELD_RISK_TIME_OF_DAY_WEIGHT=0.15
GEOSHIELD_RISK_SERVICE_PROXIMITY_WEIGHT=0.15
GEOSHIELD_RISK_USER_REPORT_WEIGHT=0.10
GEOSHIELD_RISK_CONNECTIVITY_WEIGHT=0.05
GEOSHIELD_RISK_OTHER_CONTEXT_WEIGHT=0.05
GEOSHIELD_RISK_LOW_MAX=39
GEOSHIELD_RISK_MEDIUM_MAX=59
GEOSHIELD_RISK_HIGH_MAX=79

# Weather observation provider (Open-Meteo). No API key or account is required, so there is
# deliberately no credential variable here.
GEOSHIELD_WEATHER_ENABLED=true
GEOSHIELD_WEATHER_BASE_URL=https://api.open-meteo.com
GEOSHIELD_WEATHER_CONNECT_TIMEOUT=PT2S
GEOSHIELD_WEATHER_READ_TIMEOUT=PT3S

# Historical data ingestion (optional, disabled by default)
GEOSHIELD_HISTORICAL_INGESTION_ENABLED=false
GEOSHIELD_HISTORICAL_MORTH_SOURCE=
GEOSHIELD_HISTORICAL_NCRB_SOURCE=

# Recent Safety Events (News feature - optional external integration, disabled by default)
GEOSHIELD_NEWS_ENABLED=false
GEOSHIELD_NEWS_PROVIDER=gnews
GEOSHIELD_NEWS_API_KEY=
GEOSHIELD_NEWS_BASE_URL=https://gnews.io/api/v4
GEOSHIELD_NEWS_CONNECT_TIMEOUT=PT3S
GEOSHIELD_NEWS_READ_TIMEOUT=PT5S
GEOSHIELD_NEWS_CACHE_TTL_MINUTES=45
GEOSHIELD_NEWS_CACHE_MAX_SIZE=200
GEOSHIELD_NEWS_LOOKBACK_HOURS=72
GEOSHIELD_NEWS_MAX_RESULTS=10
GEOSHIELD_NEWS_LANGUAGE=en
GEOSHIELD_NEWS_COUNTRY=in
