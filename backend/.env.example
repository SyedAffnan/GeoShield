GEOSHIELD_DB_URL=jdbc:mysql://localhost:3306/geoshield
GEOSHIELD_DB_USERNAME=geoshield
GEOSHIELD_DB_PASSWORD=CHANGE_ME
GEOSHIELD_JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_BYTES_SECRET_KEY!
GEOSHIELD_JWT_ACCESS_TOKEN_TTL=PT15M
GEOSHIELD_JWT_REFRESH_TOKEN_TTL=P30D
GEOSHIELD_BCRYPT_STRENGTH=12
GEOSHIELD_RISK_HISTORICAL_INCIDENT_WEIGHT=0.30
GEOSHIELD_RISK_WEATHER_WEIGHT=0.20
GEOSHIELD_RISK_TIME_OF_DAY_WEIGHT=0.15
GEOSHIELD_RISK_SERVICE_PROXIMITY_WEIGHT=0.15
GEOSHIELD_RISK_USER_REPORT_WEIGHT=0.10
GEOSHIELD_RISK_CONNECTIVITY_WEIGHT=0.05
GEOSHIELD_RISK_OTHER_CONTEXT_WEIGHT=0.05
GEOSHIELD_RISK_LOW_MAX=39
GEOSHIELD_RISK_MEDIUM_MAX=59
GEOSHIELD_RISK_HIGH_MAX=79
# Weather observation provider (Open-Meteo). No API key or account is required, so there is
# deliberately no credential variable here.
GEOSHIELD_WEATHER_ENABLED=true
GEOSHIELD_WEATHER_BASE_URL=https://api.open-meteo.com
GEOSHIELD_WEATHER_CONNECT_TIMEOUT=PT2S
GEOSHIELD_WEATHER_READ_TIMEOUT=PT3S
GEOSHIELD_HISTORICAL_INGESTION_ENABLED=false
GEOSHIELD_HISTORICAL_MORTH_SOURCE=
GEOSHIELD_HISTORICAL_NCRB_SOURCE=
